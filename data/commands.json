// SACC command catalog. Edit freely: SACC reloads it from Settings > Reload catalog.
// confidence: Documented = public server-host docs agree on the syntax
//             Conflicting = public sources disagree; check in-game (type '#' for autocomplete)
//             Unverified = community knowledge, no public source found
// Param kinds: Text (no spaces), Integer, Number, Player (SteamID64 or name, no spaces),
//              Bool, Choice, Message (free text, spaces allowed)
{
  "version": 1,
  "commands": [
    { "id": "help", "name": "List admin commands", "category": "General", "template": "#",
      "description": "Shows the admin command list in the in-game chat.", "confidence": "Documented" },
    { "id": "announce", "name": "Announce", "category": "General", "template": "#Announce {message}",
      "description": "Sends a server-wide message to all online players.", "confidence": "Documented",
      "params": [ { "name": "message", "kind": "Message" } ] },

    { "id": "list-players", "name": "List players", "category": "Players", "template": "#ListPlayers",
      "description": "Lists connected players (SteamID64, Steam name, character name) in chat.", "confidence": "Documented" },
    { "id": "list-players-copy", "name": "List players → clipboard", "category": "Players", "template": "#ListPlayers true",
      "description": "As List players, but asks the game to copy the result to the clipboard so SACC can import it.",
      "notes": "The 'true' clipboard flag is not in any public doc we found. If Players > Refresh times out, use 'Paste list' instead.",
      "confidence": "Unverified", "capturesClipboard": true },
    { "id": "location", "name": "Show location", "category": "Players", "template": "#Location {player}",
      "description": "Shows a player's current location. Leave the player empty for your own.", "confidence": "Documented",
      "params": [ { "name": "player", "kind": "Player", "optional": true } ] },
    { "id": "location-copy", "name": "Location → clipboard", "category": "Players", "template": "#Location {player} true",
      "description": "Asks the game to copy a player's location to the clipboard so SACC can read it.",
      "notes": "Clipboard flag unverified; see list-players-copy.",
      "confidence": "Unverified", "capturesClipboard": true,
      "params": [ { "name": "player", "kind": "Player" } ] },
    { "id": "kick", "name": "Kick", "category": "Players", "template": "#Kick {player}",
      "description": "Removes a player from the server.", "confidence": "Documented", "dangerous": true,
      "params": [ { "name": "player", "kind": "Player" } ] },
    { "id": "ban", "name": "Ban", "category": "Players", "template": "#Ban {player}",
      "description": "Kicks a player and blocks them from reconnecting until unbanned.", "confidence": "Documented", "dangerous": true,
      "params": [ { "name": "player", "kind": "Player", "hint": "SteamID64 preferred" } ] },
    { "id": "unban", "name": "Unban", "category": "Players", "template": "#Unban {player}",
      "description": "Lifts a ban.", "confidence": "Documented",
      "params": [ { "name": "player", "kind": "Player", "hint": "SteamID64" } ] },
    { "id": "mute", "name": "Mute", "category": "Players", "template": "#Mute {player}",
      "description": "Stops a player from sending chat messages.", "confidence": "Documented",
      "params": [ { "name": "player", "kind": "Player" } ] },
    { "id": "unmute", "name": "Unmute", "category": "Players", "template": "#UnMute {player}",
      "description": "Restores a muted player's chat.", "confidence": "Documented",
      "params": [ { "name": "player", "kind": "Player" } ] },
    { "id": "set-fame", "name": "Set fame points", "category": "Players", "template": "#SetFamePoints {amount} {player}",
      "description": "Sets a player's fame points.", "confidence": "Documented",
      "params": [ { "name": "amount", "kind": "Integer" }, { "name": "player", "kind": "Player" } ] },
    { "id": "change-currency", "name": "Change currency balance", "category": "Players",
      "template": "#ChangeCurrencyBalance {currency} {amount} {player}",
      "description": "Adds (or with a negative amount, removes) money or gold from a player.",
      "confidence": "Unverified",
      "params": [ { "name": "currency", "kind": "Choice", "choices": [ "Normal", "Gold" ], "default": "Normal" },
                  { "name": "amount", "kind": "Integer" }, { "name": "player", "kind": "Player" } ] },
    { "id": "set-fake-name", "name": "Set fake name", "category": "Players", "template": "#SetFakeName {name}",
      "description": "Changes the name other players see for you.", "confidence": "Unverified",
      "params": [ { "name": "name", "kind": "Text" } ] },
    { "id": "clear-fake-name", "name": "Clear fake name", "category": "Players", "template": "#ClearFakeName",
      "description": "Restores your real name.", "confidence": "Unverified" },

    { "id": "teleport", "name": "Teleport to coordinates", "category": "Teleport",
      "template": "#Teleport {x} {y} {z}[ {player}]",
      "description": "Moves you (or the given player) to world coordinates.",
      "notes": "Coordinates first, player last. This is the order scum-map.com's Copy TP and SCUM Admin Helper both use; some public guides list the player first.",
      "confidence": "Documented",
      "params": [ { "name": "x", "kind": "Number" }, { "name": "y", "kind": "Number" }, { "name": "z", "kind": "Number" },
                  { "name": "player", "kind": "Player", "optional": true, "hint": "empty = you" } ] },
    { "id": "teleport-to-player", "name": "Teleport me to player", "category": "Teleport", "template": "#TeleportToPlayer {player}",
      "description": "Moves you to another player.",
      "notes": "Also seen as #TeleportTo.", "confidence": "Conflicting",
      "params": [ { "name": "player", "kind": "Player" } ] },
    { "id": "teleport-to-me", "name": "Bring player to me", "category": "Teleport", "template": "#TeleportToMe {player}",
      "description": "Moves another player to you.", "confidence": "Unverified",
      "params": [ { "name": "player", "kind": "Player" } ] },

    { "id": "spawn-item", "name": "Spawn item", "category": "Spawning", "template": "#SpawnItem {item} {amount}[ StackCount {stack}]",
      "description": "Spawns an item in front of you. StackCount sets rounds in a magazine or units in a stack; a large value (e.g. 200) fills it, since the game caps overflow.",
      "confidence": "Documented",
      "notes": "Base form verified in-game 2026-10-26 (#SpawnItem WeaponSights_AimPRO 1 → 'Spawned WeaponSights_AimPRO'). The StackCount suffix is the form SCUM Admin Helper used for cash stacks.",
      "params": [ { "name": "item", "kind": "Text", "hint": "Asset id; find it with List items" },
                  { "name": "amount", "kind": "Integer", "optional": true, "default": "1" },
                  { "name": "stack", "kind": "Integer", "optional": true, "hint": "StackCount, e.g. 30, or 200 for full" } ] },
    { "id": "list-items", "name": "List items", "category": "Spawning", "template": "#ListItems {filter}",
      "description": "Lists spawnable item ids matching a filter (all if empty).",
      "notes": "Also seen as '#ListAssets Item <filter>'.", "confidence": "Conflicting",
      "params": [ { "name": "filter", "kind": "Text", "optional": true } ] },
    { "id": "spawn-vehicle", "name": "Spawn vehicle", "category": "Spawning", "template": "#SpawnVehicle {vehicle}",
      "description": "Spawns a vehicle in front of you.", "confidence": "Documented",
      "params": [ { "name": "vehicle", "kind": "Text" } ] },
    { "id": "list-spawned-vehicles", "name": "List spawned vehicles", "category": "Spawning", "template": "#ListSpawnedVehicles",
      "description": "Lists vehicles currently in the world.", "confidence": "Unverified" },
    { "id": "spawn-animal", "name": "Spawn animal", "category": "Spawning", "template": "#SpawnAnimal {animal} {amount}",
      "description": "Spawns animals in front of you.", "confidence": "Documented",
      "params": [ { "name": "animal", "kind": "Text", "hint": "Find ids with List animals" },
                  { "name": "amount", "kind": "Integer", "optional": true, "default": "1" } ] },
    { "id": "list-animals", "name": "List animals", "category": "Spawning", "template": "#ListAnimals",
      "description": "Lists spawnable animal ids.", "confidence": "Documented" },
    { "id": "spawn-random-animal", "name": "Spawn random animal", "category": "Spawning", "template": "#SpawnRandomAnimal",
      "description": "Spawns a random animal in front of you.", "confidence": "Documented" },
    { "id": "spawn-random-zombie", "name": "Spawn random zombie", "category": "Spawning", "template": "#SpawnRandomZombie",
      "description": "Spawns a random zombie (puppet) in front of you.", "confidence": "Documented" },

    { "id": "set-time", "name": "Set time", "category": "World", "template": "#SetTime {hour}",
      "description": "Sets the time of day (0-24).", "confidence": "Documented",
      "params": [ { "name": "hour", "kind": "Number" } ] },
    { "id": "set-weather", "name": "Set weather", "category": "World", "template": "#SetWeather {intensity}",
      "description": "0 = clear, 1 = strongest storm.", "confidence": "Documented",
      "params": [ { "name": "intensity", "kind": "Number" } ] },
    { "id": "god-mode", "name": "God mode", "category": "World", "template": "#SetGodMode {enabled}",
      "description": "Instant building and no resource cost; does not make you immortal.",
      "notes": "Some sources describe it as a toggle with no argument.", "confidence": "Conflicting",
      "params": [ { "name": "enabled", "kind": "Bool", "default": "true" } ] },
    { "id": "destroy-all-vehicles", "name": "Destroy ALL vehicles", "category": "World", "template": "#DestroyAllVehicles Please",
      "description": "Destroys every vehicle on the server. The literal word 'Please' is part of the command.",
      "confidence": "Documented", "dangerous": true }
  ]
