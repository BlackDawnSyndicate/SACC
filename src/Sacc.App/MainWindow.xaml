<Window x:Class="Sacc.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:infra="clr-namespace:Sacc.App.Infrastructure"
        xmlns:map="clr-namespace:Sacc.App.Map"
        Title="{Binding AppTitle}" Height="760" Width="1120" MinHeight="520" MinWidth="820"
        Topmost="{Binding AlwaysOnTop}" Background="{DynamicResource PanelBrush}" Foreground="{DynamicResource TextBrush}">
    <Window.InputBindings>
        <KeyBinding Key="Escape" Command="{Binding StopCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <DataTemplate x:Key="TextField">
            <TextBox Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}" ToolTip="{Binding Hint}"/>
        </DataTemplate>
        <DataTemplate x:Key="BoolField">
            <CheckBox IsChecked="{Binding BoolValue}" VerticalAlignment="Center" Content="enabled"/>
        </DataTemplate>
        <DataTemplate x:Key="ChoiceField">
            <ComboBox ItemsSource="{Binding Def.Choices}" SelectedItem="{Binding Value}"/>
        </DataTemplate>
        <DataTemplate x:Key="PlayerField">
            <ComboBox IsEditable="True" TextSearch.TextPath="SteamId" ToolTip="{Binding Hint}"
                      ItemsSource="{Binding DataContext.Players, RelativeSource={RelativeSource AncestorType=Window}}"
                      Text="{Binding Value, UpdateSourceTrigger=PropertyChanged}">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Text="{Binding Display}"/>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </DataTemplate>
        <infra:ParamTemplateSelector x:Key="ParamSelector"
                                     Text="{StaticResource TextField}" Bool="{StaticResource BoolField}"
                                     Choice="{StaticResource ChoiceField}" Player="{StaticResource PlayerField}"/>
    </Window.Resources>

    <DockPanel>
        <!-- Header -->
        <Border DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Padding="14,10">
            <DockPanel>
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Right" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#B3261E"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding GameOk}" Value="True">
                                        <Setter Property="Fill" Value="#4CAF50"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding GameStatusText}" Foreground="#DDE3E6" Margin="0,0,18,0" VerticalAlignment="Center"/>
                    <CheckBox IsChecked="{Binding DryRun}" Foreground="#FFD27F" VerticalAlignment="Center" Margin="0,0,14,0"
                              ToolTip="Log commands without sending anything to the game">Dry run</CheckBox>
                    <CheckBox IsChecked="{Binding AlwaysOnTop}" Foreground="#DDE3E6" VerticalAlignment="Center">On top</CheckBox>
                </StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="SACC" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                    <TextBlock Text="SCUM Admin Command Console" FontSize="14" Foreground="#DDE3E6" Margin="10,5,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Status bar -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,5">
            <DockPanel>
                <Button DockPanel.Dock="Right" Command="{Binding StopCommand}" Margin="0" MinWidth="0"
                        Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" Content="Stop (Esc)"/>
                <TextBlock Text="{Binding Status}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" ToolTip="{Binding Status}"/>
            </DockPanel>
        </Border>

        <TabControl Margin="8" Padding="10">
            <!-- ============================================================ Console -->
            <TabItem Header="Console">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Column="0">
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search commands"/>
                        <ListBox ItemsSource="{Binding CommandsView}" SelectedItem="{Binding SelectedCommand}"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" Margin="2,8,0,2"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2">
                                        <Border DockPanel.Dock="Right" CornerRadius="3" Padding="5,0" Margin="6,0,0,0" VerticalAlignment="Top"
                                                Background="{Binding Confidence, Converter={StaticResource ConfidenceBrush}}">
                                            <TextBlock Text="{Binding Confidence}" Foreground="White" FontSize="10"/>
                                        </Border>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Name}"/>
                                            <TextBlock Text="{Binding Template}" Style="{StaticResource Mono}" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
                                        </StackPanel>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <ScrollViewer Grid.Column="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel DataContext="{Binding}">
                            <TextBlock Text="Pick a command on the left." FontSize="14">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource Muted}">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedCommand}" Value="{x:Null}">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <StackPanel Visibility="{Binding SelectedCommand, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding SelectedCommand.Name}" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SelectedCommand.Description}" TextWrapping="Wrap" Margin="0,4,0,0"/>
                                <TextBlock Text="{Binding SelectedCommand.Notes}" Style="{StaticResource Muted}" Margin="0,4,0,0" FontStyle="Italic"
                                           Visibility="{Binding SelectedCommand.Notes, Converter={StaticResource NotEmptyToVisibility}}"/>

                                <ItemsControl ItemsSource="{Binding Fields}" Margin="0,10,0,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,6">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="140"/>
                                                    <ColumnDefinition Width="*" MaxWidth="420"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                <ContentControl Grid.Column="1" Content="{Binding}" ContentTemplateSelector="{StaticResource ParamSelector}"/>
                                                <TextBlock Grid.Column="2" Text="{Binding Hint}" Style="{StaticResource Muted}" Margin="8,0,0,0" VerticalAlignment="Center"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>

                                <TextBlock Text="Will send" Style="{StaticResource SectionLabel}"/>
                                <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6">
                                    <TextBlock Text="{Binding Preview}" Style="{StaticResource Mono}" FontSize="14" TextWrapping="Wrap"/>
                                </Border>
                                <TextBlock Text="{Binding PreviewProblem}" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,4,0,0"
                                           Visibility="{Binding PreviewProblem, Converter={StaticResource NotEmptyToVisibility}}"/>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding SendCommand}" Content="Send to game"/>
                                    <Button Command="{Binding CopyCommand}" Content="Copy"/>
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,10,0,0">
                        <Button DockPanel.Dock="Right" Command="{Binding SendFreeformCommand}" Margin="6,0,0,0" Content="Send"/>
                        <TextBlock DockPanel.Dock="Left" Text="Raw:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                        <TextBox x:Name="FreeformBox" Text="{Binding FreeformText, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                 PreviewKeyDown="FreeformBox_PreviewKeyDown"
                                 ToolTip="Type any admin command. Enter sends, Up/Down recalls history."/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Players -->
            <TabItem Header="Players">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RefreshPlayersCommand}" Content="Refresh from game"
                                ToolTip="Sends #ListPlayers true and reads the clipboard"/>
                        <Button Command="{Binding PastePlayersCommand}" Content="Paste list"
                                ToolTip="Parse #ListPlayers output you copied yourself"/>
                        <Button Command="{Binding ImportSahFilesCommand}" Content="Import SAH players…"
                                ToolTip="Import a 'SAH Players (date).json' export"/>
                        <Button Command="{Binding ClearPlayersCommand}" Content="Clear"/>
                        <CheckBox Content="{Binding PlayersOnlineLabel}" IsChecked="{Binding PlayersOnlineOnly}" VerticalAlignment="Center" Margin="12,0,0,0"
                                  ToolTip="Only players in the last #ListPlayers output (Refresh from game or Paste list)"/>
                        <TextBox Text="{Binding PlayerSearch, UpdateSourceTrigger=PropertyChanged}" Width="220" Margin="12,0,0,0" VerticalContentAlignment="Center"
                                 ToolTip="Filter by name or SteamID64"/>
                    </StackPanel>
                    <Border DockPanel.Dock="Right" Width="260" Margin="10,0,0,0" Padding="10" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="{Binding SelectedPlayer.Display, FallbackValue='Select a player'}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                            <TextBlock Text="Tracking" Style="{StaticResource SectionLabel}"/>
                            <DockPanel Margin="0,0,0,2">
                                <CheckBox DockPanel.Dock="Left" Content="Track every" IsChecked="{Binding Tracking}" VerticalAlignment="Center"
                                          ToolTip="Reads #ListPlayers on a timer and records where everyone is. Each read types into the game, so this starts off whenever SACC opens."/>
                                <TextBlock DockPanel.Dock="Right" Text="s" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                <TextBox Text="{Binding TrackInterval, UpdateSourceTrigger=LostFocus}" Margin="6,0,0,0" AutomationProperties.Name="Track interval seconds"
                                         ToolTip="Seconds between reads, 10 or more"/>
                            </DockPanel>
                            <TextBlock Text="{Binding TrackingLabel}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,2"/>
                            <WrapPanel>
                                <Button Command="{Binding ShowTrackCommand}" Content="Show on map" ToolTip="Draw the selected player's track on the Map tab"/>
                                <Button Command="{Binding ExportTrackCommand}" Content="Export…" ToolTip="Save the selected player's track as CSV: time, SteamID, name, X, Y, Z"/>
                                <Button Command="{Binding ExportAllTracksCommand}" Content="Export all…" ToolTip="Save everyone's tracks as one CSV"/>
                                <Button Command="{Binding ClearTracksCommand}" Content="Clear" ToolTip="Delete every tracked point (tracks.csv)"/>
                            </WrapPanel>
                            <TextBlock Text="Teleport" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel>
                                <Button Command="{Binding PlayerActionCommand}" CommandParameter="teleport-to-player" Content="Go to"/>
                                <Button Command="{Binding PlayerActionCommand}" CommandParameter="teleport-to-me" Content="Bring"/>
                                <Button Command="{Binding PlayerActionCommand}" CommandParameter="location" Content="Locate"/>
                                <Button Command="{Binding UsePlayerAsTargetCommand}" Content="Use as target"
                                        ToolTip="Fill the target box on the Locations and Macros tabs"/>
                            </WrapPanel>
                            <TextBlock Text="Fame / currency" Style="{StaticResource SectionLabel}"/>
                            <DockPanel Margin="0,0,0,6">
                                <ComboBox DockPanel.Dock="Right" Width="80" Margin="6,0,0,0" ItemsSource="{Binding Currencies}" SelectedItem="{Binding PlayerCurrency}"/>
                                <TextBox Text="{Binding PlayerAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Amount"/>
                            </DockPanel>
                            <WrapPanel>
                                <Button Command="{Binding PlayerActionCommand}" CommandParameter="set-fame" Content="Set fame"/>
                                <Button Command="{Binding PlayerActionCommand}" CommandParameter="change-currency" Content="Add money"/>
                            </WrapPanel>
                            <TextBlock Text="Moderation" Style="{StaticResource SectionLabel}"/>
                            <WrapPanel>
                                <Button Command="{Binding PlayerActionCommand}" CommandParameter="mute" Content="Mute"/>
                                <Button Command="{Binding PlayerActionCommand}" CommandParameter="unmute" Content="Unmute"/>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding PlayerActionCommand}" CommandParameter="kick" Content="Kick"/>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding PlayerActionCommand}" CommandParameter="ban" Content="Ban"/>
                            </WrapPanel>
                        </StackPanel>
                    </Border>
                    <DataGrid ItemsSource="{Binding PlayersView}" SelectedItem="{Binding SelectedPlayer}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Nickname}" Width="2*"/>
                            <DataGridTextColumn Header="Steam name" Binding="{Binding PlatformName}" Width="1.5*"/>
                            <DataGridTextColumn Header="SteamID64" Binding="{Binding SteamId}" Width="150"/>
                            <DataGridTextColumn Header="Fame" Binding="{Binding Fame}" Width="70"/>
                            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="90"/>
                            <DataGridTextColumn Header="Gold" Binding="{Binding Gold}" Width="60"/>
                            <DataGridTextColumn Header="Sector" Binding="{Binding Converter={StaticResource Sector}}" Width="60"/>
                            <DataGridTextColumn Header="Location" Binding="{Binding Location}" Width="2*"/>
                            <DataGridTextColumn Header="Seen" Binding="{Binding LastSeen, StringFormat='MMM d HH:mm'}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ Spawner -->
            <TabItem Header="Spawner">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="16"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding ItemMatchSummary}" Style="{StaticResource Muted}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Items" FontSize="16" FontWeight="SemiBold"/>
                        </DockPanel>
                        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,6">
                            <TextBox DockPanel.Dock="Right" Width="60" Margin="6,0,0,0" Text="{Binding ItemAmount, UpdateSourceTrigger=PropertyChanged}" ToolTip="Amount"/>
                            <TextBox x:Name="ItemCodeBox" Text="{Binding ItemCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                     PreviewKeyDown="ItemCodeBox_PreviewKeyDown"
                                     ToolTip="Item asset id. Type any part of it ('m16 mag'); Down picks from the list, Enter spawns."/>
                        </DockPanel>
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="StackCount" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Width="60" Text="{Binding ItemStack, UpdateSourceTrigger=PropertyChanged}"
                                     IsEnabled="{Binding ItemStackFull, Converter={StaticResource InverseBool}}"
                                     ToolTip="Optional: rounds in a magazine or units in a stack. Leave empty for the game default."/>
                            <CheckBox Content="Full" IsChecked="{Binding ItemStackFull}" VerticalAlignment="Center" Margin="10,0,0,0"
                                      ToolTip="Send the 'full' StackCount from Settings (200 by default); the game caps it at the item's maximum"/>
                            <CheckBox Content="Fill magazines" IsChecked="{Binding Settings.SpawnerFillMagazines}" VerticalAlignment="Center" Margin="10,0,0,0"
                                      ToolTip="Magazines spawn full unless you enter a StackCount. Which codes count as magazines is set in Settings."/>
                        </StackPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SpawnItemCommand}" Content="Spawn"/>
                            <Button Command="{Binding ListItemsCommand}" Content="Search in game" ToolTip="Sends #ListItems with the text as a filter"/>
                            <Button Command="{Binding RefreshGameItemsCommand}" Content="Refresh list from game" ToolTip="{Binding GameItemsTip}"/>
                            <Button Command="{Binding AddFavoriteItemCommand}" Content="☆ Favorite"/>
                        </WrapPanel>
                        <ListBox x:Name="ItemFavorites" DockPanel.Dock="Bottom" Height="140" ItemsSource="{Binding FavoriteItems}" MouseDoubleClick="ItemFavorites_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" MinWidth="0" Padding="4,0" Margin="8,0,0,0" AutomationProperties.Name="Remove"
                                                Command="{Binding DataContext.RemoveFavoriteItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CodeWithIcon}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,4"
                                   Text="Favorites: double-click to spawn with the settings above."/>
                        <ListBox x:Name="ItemMatchesList" ItemsSource="{Binding ItemMatches}" ItemTemplate="{StaticResource CodeWithIcon}"
                                 PreviewMouseLeftButtonUp="ItemMatches_Click" MouseDoubleClick="ItemMatches_DoubleClick"
                                 KeyDown="ItemMatches_KeyDown" VirtualizingPanel.IsVirtualizing="True"
                                 ToolTip="Click to pick, double-click to spawn, Enter to pick"/>
                    </DockPanel>
                    <DockPanel Grid.Column="2">
                        <DockPanel DockPanel.Dock="Top">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding VehicleMatchSummary}" Style="{StaticResource Muted}" VerticalAlignment="Bottom"/>
                            <TextBlock Text="Vehicles" FontSize="16" FontWeight="SemiBold"/>
                        </DockPanel>
                        <TextBox x:Name="VehicleCodeBox" DockPanel.Dock="Top" Margin="0,6,0,6" Text="{Binding VehicleCode, UpdateSourceTrigger=PropertyChanged}"
                                 FontFamily="Cascadia Mono, Consolas" PreviewKeyDown="VehicleCodeBox_PreviewKeyDown"
                                 ToolTip="Vehicle asset id. Type any part of it; Down picks from the list, Enter spawns."/>
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SpawnVehicleCommand}" Content="Spawn"/>
                            <Button Command="{Binding AddFavoriteVehicleCommand}" Content="☆ Favorite"/>
                        </WrapPanel>
                        <ListBox x:Name="VehicleFavorites" DockPanel.Dock="Bottom" Height="140" ItemsSource="{Binding FavoriteVehicles}" MouseDoubleClick="VehicleFavorites_DoubleClick">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" MinWidth="0" Padding="4,0" Margin="8,0,0,0" AutomationProperties.Name="Remove"
                                                Command="{Binding DataContext.RemoveFavoriteVehicleCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CodeWithIcon}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,4" Text="Favorites: double-click to spawn."/>
                        <ListBox x:Name="VehicleMatchesList" Margin="0,6,0,0" ItemsSource="{Binding VehicleMatches}" ItemTemplate="{StaticResource CodeWithIcon}"
                                 PreviewMouseLeftButtonUp="VehicleMatches_Click" MouseDoubleClick="VehicleMatches_DoubleClick"
                                 KeyDown="VehicleMatches_KeyDown"
                                 ToolTip="Click to pick, double-click to spawn, Enter to pick"/>
                    </DockPanel>
                    <DockPanel Grid.Column="4">
                        <TextBlock DockPanel.Dock="Top" Text="Container" FontSize="16" FontWeight="SemiBold"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,6,0,6">
                            <Button DockPanel.Dock="Right" Content="← picked item" Margin="6,0,0,0" Command="{Binding ContainerFromPickedCommand}"
                                    ToolTip="Use the item in the Items box as the container"/>
                            <TextBox Text="{Binding ContainerCode, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                     ToolTip="The container to spawn, e.g. Hiking_Backpack_01_02. Find it in Items, then press ← picked item."/>
                        </DockPanel>
                        <TextBlock DockPanel.Dock="Top" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"
                                   Text="Filled to its space and weight limit with stacks of:"/>
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button DockPanel.Dock="Right" Content="Add" Margin="6,0,0,0" Command="{Binding AddContainerItemCommand}"/>
                            <TextBox Text="{Binding ContainerNewItem, UpdateSourceTrigger=PropertyChanged}" FontFamily="Cascadia Mono, Consolas"
                                     ToolTip="Item codes to add, separated by spaces or commas; Enter adds them">
                                <TextBox.InputBindings>
                                    <KeyBinding Key="Enter" Command="{Binding AddContainerItemCommand}"/>
                                </TextBox.InputBindings>
                            </TextBox>
                        </DockPanel>
                        <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <Button Content="+ picked item" Command="{Binding AddPickedToContainerCommand}" ToolTip="Add the item in the Items box"/>
                            <Button Content="Paste command" Command="{Binding PasteContainerCommand}" ToolTip="Load a copied #SpawnInventoryFullOf line into the builder"/>
                            <Button Content="Clear" Command="{Binding ClearContainerCommand}"/>
                        </WrapPanel>
                        <!-- Bottom-docked parts, in order from the bottom: saved containers, then preview and buttons. -->
                        <ListBox DockPanel.Dock="Bottom" Height="140" ItemsSource="{Binding ContainerPresets}" SelectedItem="{Binding SelectedContainerPreset}"
                                 MouseDoubleClick="ContainerPresets_DoubleClick" ToolTip="Click to load into the builder, double-click to spawn">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" MinWidth="0" Padding="4,0" Margin="8,0,0,0" AutomationProperties.Name="Remove"
                                                Command="{Binding DataContext.RemoveContainerPresetCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <TextBlock Text="{Binding Summary}" FontFamily="Cascadia Mono, Consolas" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                        <TextBlock DockPanel.Dock="Bottom" Style="{StaticResource Muted}" Margin="0,8,0,4"
                                   Text="Saved containers: click to load, double-click to spawn."/>
                        <WrapPanel DockPanel.Dock="Bottom">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SpawnContainerCommand}" Content="Spawn"/>
                            <Button Command="{Binding SaveContainerCommand}" Content="☆ Save"/>
                            <Button Command="{Binding ContainerToKitCommand}" Content="{Binding ContainerToKitLabel}"
                                    ToolTip="Add this container to the kit selected on the Kits tab (once; change Amount there)"/>
                            <TextBlock Text="Number" VerticalAlignment="Center" Margin="10,0,6,0"/>
                            <TextBox Width="40" Text="{Binding ContainerOption, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="The number after the container in #SpawnInventoryFullOf. What it does isn't known yet; 0 works."/>
                        </WrapPanel>
                        <TextBox DockPanel.Dock="Bottom" Text="{Binding ContainerPreview, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap"
                                 FontFamily="Cascadia Mono, Consolas" Margin="0,6,0,6" ToolTip="The line Spawn sends"/>
                        <ListBox ItemsSource="{Binding ContainerItems}">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="✕" MinWidth="0" Padding="4,0" Margin="8,0,0,0" AutomationProperties.Name="Remove"
                                                Command="{Binding DataContext.RemoveContainerItemCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource CodeWithIcon}"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Kits -->
            <TabItem Header="Kits">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="340"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Top">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewKitCommand}" Content="New kit"
                                    ToolTip="Create an empty kit in the current folder"/>
                            <Button Command="{Binding ImportSahFolderCommand}" Content="Import SAH folder…"
                                    ToolTip="Import every SCUM Admin Helper pack, players export and #spawnitem text file under a folder (zips included)"/>
                            <Button Command="{Binding ImportSahFilesCommand}" Content="Import files…"/>
                            <Button Command="{Binding ResolveKitsCommand}" Content="Resolve ids"
                                    ToolTip="Re-check unresolved SAH item ids against the item table"/>
                        </WrapPanel>
                        <TextBox DockPanel.Dock="Top" Margin="0,0,0,6" Text="{Binding KitSearch, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="Search kit names, folders and item codes"/>
                        <ListBox x:Name="KitList" ItemsSource="{Binding KitsView}" SelectedItem="{Binding SelectedKit}"
                                 SelectionChanged="KitList_SelectionChanged"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled" HorizontalContentAlignment="Stretch"
                                 VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                            <ListBox.GroupStyle>
                                <GroupStyle>
                                    <GroupStyle.HeaderTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name, TargetNullValue='(no folder)'}" FontWeight="Bold"
                                                       Foreground="{DynamicResource AccentBrush}" Margin="2,8,0,2" TextWrapping="Wrap"/>
                                        </DataTemplate>
                                    </GroupStyle.HeaderTemplate>
                                </GroupStyle>
                            </ListBox.GroupStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <DockPanel Margin="2">
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Items.Count, StringFormat='{}{0} items'}"
                                                   Foreground="{DynamicResource MutedBrush}" Margin="6,0,0,0"/>
                                        <TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </DockPanel>

                    <DockPanel Grid.Column="2" Visibility="{Binding SelectedKit, Converter={StaticResource NotEmptyToVisibility}}">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBox x:Name="KitNameBox" Text="{Binding SelectedKit.Name, UpdateSourceTrigger=LostFocus}" FontSize="16" FontWeight="SemiBold"
                                     Margin="0,0,0,4" LostFocus="KitDetail_LostFocus" ToolTip="Kit name"/>
                            <DockPanel Margin="0,0,0,2">
                                <TextBlock Text="Folder" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBlock DockPanel.Dock="Right" Style="{StaticResource Muted}" VerticalAlignment="Center" Margin="8,0,0,0"
                                           Text="{Binding SelectedKit.Source}" MaxWidth="320" TextTrimming="CharacterEllipsis" ToolTip="{Binding SelectedKit.Source}"/>
                                <ComboBox IsEditable="True" ItemsSource="{Binding KitFolders}" MinWidth="200"
                                          Text="{Binding SelectedKitFolder, UpdateSourceTrigger=LostFocus}"
                                          ToolTip="Pick a folder or type a new one (use / for subfolders)"/>
                            </DockPanel>
                            <TextBlock Text="{Binding SelectedKit.Description}" TextWrapping="Wrap" Margin="0,4,0,0"
                                       Visibility="{Binding SelectedKit.Description, Converter={StaticResource NotEmptyToVisibility}}"/>
                            <TextBlock Foreground="{StaticResource ErrorBrush}" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="{Binding SelectedKit.UnresolvedCount, StringFormat='{}{0} item(s) have SAH ids with no spawn code yet; they are skipped when spawning.'}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding SelectedKit.UnresolvedCount}" Value="0">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding SpawnKitCommand}" Content="Spawn kit"/>
                                <CheckBox Content="Fill magazines" IsChecked="{Binding SelectedKit.FillMagazines}" VerticalAlignment="Center" Margin="0,0,12,6"
                                          Click="KitOption_Click"
                                          ToolTip="Spawn every magazine in this kit with the Full StackCount (Settings → magazine pattern decides what counts)"/>
                                <Button Command="{Binding CloneKitCommand}" Content="Clone"
                                        ToolTip="Make an editable copy of this kit/pack in the same folder"/>
                                <Button Command="{Binding KitToMacroCommand}" Content="Copy to macro"/>
                                <Button Command="{Binding CopyKitAsPackCommand}" Content="Copy as WhalleyBot pack"
                                        ToolTip="Copies the kit's spawn lines (split, magazines filled) for a pack in WhalleyBot's panel"/>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteKitCommand}" Content="Delete"/>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteKitGroupCommand}" Content="Delete folder"/>
                            </WrapPanel>

                            <!-- Add-item row: type-ahead with icons, like the Spawner. -->
                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="8,6" Margin="0,4,0,6">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                        <TextBlock Text="Amount" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Width="44" Text="{Binding NewItemAmount, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="NewItemField_PreviewKeyDown"
                                                 ToolTip="New item amount"/>
                                        <TextBlock Text="StackCount" VerticalAlignment="Center" Margin="8,0,4,0"/>
                                        <TextBox Width="44" Text="{Binding NewItemStack, UpdateSourceTrigger=PropertyChanged}" PreviewKeyDown="NewItemField_PreviewKeyDown"
                                                 ToolTip="New item StackCount (optional)"
                                                 IsEnabled="{Binding NewItemFull, Converter={StaticResource InverseBool}}"/>
                                        <CheckBox Content="Full" IsChecked="{Binding NewItemFull}" VerticalAlignment="Center" Margin="8,0,8,0"/>
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding AddKitItemCommand}" Content="Add item" Margin="0" MinWidth="0"/>
                                        <Button Command="{Binding RemoveKitItemCommand}" Content="Remove item" Margin="6,0,0,0" MinWidth="0"
                                                ToolTip="Remove the selected row from this kit"/>
                                    </StackPanel>
                                    <Border Width="28" Height="28" Margin="0,0,6,0" Background="#1F2A30" CornerRadius="3">
                                        <Image Source="{Binding NewItemCode, Converter={StaticResource CodeToIcon}}" Stretch="Uniform"
                                               RenderOptions.BitmapScalingMode="HighQuality"/>
                                    </Border>
                                    <Grid>
                                        <TextBox x:Name="NewItemBox" Text="{Binding NewItemCode, UpdateSourceTrigger=PropertyChanged}"
                                                 FontFamily="Cascadia Mono, Consolas" PreviewKeyDown="NewItemBox_PreviewKeyDown"
                                                 ToolTip="New item: type any part of a code; Down picks a suggestion, Enter adds"/>
                                        <Popup x:Name="NewItemPopup" PlacementTarget="{Binding ElementName=NewItemBox}" Placement="Bottom"
                                               IsOpen="{Binding NewItemPopupOpen}" StaysOpen="False" AllowsTransparency="True"
                                               Width="{Binding ActualWidth, ElementName=NewItemBox}">
                                            <Border Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                                                <ListBox x:Name="NewItemSuggestions" ItemsSource="{Binding NewItemMatches}" MaxHeight="320"
                                                         ItemTemplate="{StaticResource CodeWithIcon}" BorderThickness="0"
                                                         PreviewMouseLeftButtonUp="NewItemSuggestions_Click" KeyDown="NewItemSuggestions_KeyDown"/>
                                            </Border>
                                        </Popup>
                                    </Grid>
                                </DockPanel>
                            </Border>
                            <!-- Add-container row: a saved container from Spawner → Container, Amount from the row above. -->
                            <DockPanel Margin="0,0,0,6">
                                <TextBlock Text="Container" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <Button DockPanel.Dock="Right" Command="{Binding AddContainerToKitCommand}" Content="Add container" Margin="6,0,0,0" MinWidth="0"
                                        ToolTip="Add the picked container, as many as Amount above. Each one is a #SpawnInventoryFullOf line."/>
                                <ComboBox ItemsSource="{Binding ContainerPresets}" SelectedItem="{Binding KitContainerChoice}" DisplayMemberPath="Summary"
                                          FontFamily="Cascadia Mono, Consolas"
                                          ToolTip="Saved containers (build and ☆ Save them on Spawner → Container)"/>
                            </DockPanel>
                        </StackPanel>
                        <ItemsControl DockPanel.Dock="Bottom" ItemsSource="{Binding SelectedKit.ExtraCommands}" Margin="0,6,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding}" Style="{StaticResource Mono}"/>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <DataGrid ItemsSource="{Binding SelectedKitItems}" SelectedItem="{Binding SelectedKitItem}" CellEditEnding="Bookmarks_CellEditEnding"
                                  CanUserAddRows="False" CanUserDeleteRows="True" RowEditEnding="KitItems_RowEditEnding"
                                  ToolTip="Edit codes, amounts and stacks in place; select a row and press Delete (or Remove item) to remove it">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Header="" Width="40" IsReadOnly="True">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border Width="32" Height="32" Margin="2" Background="#1F2A30" CornerRadius="3">
                                                <Image Source="{Binding Code, Converter={StaticResource CodeToIcon}}" Stretch="Uniform"
                                                       RenderOptions.BitmapScalingMode="HighQuality"/>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Header="Spawn code / command" Binding="{Binding Code}" Width="*" FontFamily="Cascadia Mono, Consolas"/>
                                <DataGridTextColumn Header="Amount" Binding="{Binding Amount}" Width="70"/>
                                <DataGridTextColumn Header="StackCount" Binding="{Binding StackCount, TargetNullValue=''}" Width="85"/>
                                <DataGridCheckBoxColumn Header="Full" Binding="{Binding StackFull, UpdateSourceTrigger=PropertyChanged}" Width="45"/>
                                <DataGridTextColumn Header="SAH id" Binding="{Binding SahId}" Width="70" IsReadOnly="True"/>
                            </DataGrid.Columns>
                        </DataGrid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Map -->
            <TabItem Header="Map" x:Name="MapTab">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="270"/>
                        <ColumnDefinition Width="10"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <DockPanel>
                        <StackPanel DockPanel.Dock="Top">
                            <DockPanel Margin="0,0,0,6">
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshMapCommand}" Content="Refresh" Margin="6,0,0,0" MinWidth="0"
                                        ToolTip="Re-download markers and the current map version from scum-map.com"/>
                                <ComboBox ItemsSource="{Binding MapTypeNames}" SelectedItem="{Binding MapType}" ToolTip="Map style"/>
                            </DockPanel>
                            <ComboBox ItemsSource="{Binding MapGridChoices}" SelectedValuePath="Key" DisplayMemberPath="Value"
                                      SelectedValue="{Binding MapGrid}" Margin="0,0,0,6" ToolTip="Sector / keypad grid overlay"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Command="{Binding MapGoToCommand}" Content="Go" Margin="6,0,0,0" MinWidth="0"/>
                                <TextBox Text="{Binding MapGoTo, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Go to"
                                         ToolTip="Go to a sector (B2), keypad (B27), coordinates (X Y) or a player name">
                                    <TextBox.InputBindings>
                                        <KeyBinding Key="Enter" Command="{Binding MapGoToCommand}"/>
                                    </TextBox.InputBindings>
                                </TextBox>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshPlayersCommand}" Content="Refresh" Padding="6,0" Margin="4,0,0,0"
                                        ToolTip="Sends #ListPlayers true and reads the clipboard"/>
                                <CheckBox Content="{Binding MapOnlineLabel}" IsChecked="{Binding MapShowOnline}" VerticalAlignment="Center"
                                          ToolTip="{Binding MapOnlineTip}"/>
                            </DockPanel>
                            <CheckBox Content="Offline players (last known)" IsChecked="{Binding MapShowPlayers}" Margin="0,0,0,4"
                                      ToolTip="Everyone else, where they were last seen (grey)"/>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Command="{Binding PasteFlagsCommand}" Content="Paste" Padding="6,0" Margin="4,0,0,0"
                                        ToolTip="Read #ListFlags output you copied yourself"/>
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshFlagsCommand}" Content="Refresh" Padding="6,0" Margin="4,0,0,0"
                                        ToolTip="Sends #ListFlags 1 true, 2 true, … and reads each page from the clipboard"/>
                                <CheckBox Content="{Binding MapFlagsLabel}" IsChecked="{Binding MapShowFlags}" VerticalAlignment="Center"
                                          ToolTip="{Binding MapFlagsTip}"/>
                            </DockPanel>
                            <DockPanel Margin="0,0,0,4">
                                <Button DockPanel.Dock="Right" Command="{Binding PasteVehiclesCommand}" Content="Paste" Padding="6,0" Margin="4,0,0,0"
                                        ToolTip="Read #ListSpawnedVehicles output you copied yourself"/>
                                <Button DockPanel.Dock="Right" Command="{Binding RefreshVehiclesCommand}" Content="Refresh" Padding="6,0" Margin="4,0,0,0"
                                        ToolTip="Sends #ListSpawnedVehicles true and reads the clipboard"/>
                                <CheckBox Content="{Binding MapVehiclesLabel}" IsChecked="{Binding MapShowVehicles}" VerticalAlignment="Center"
                                          ToolTip="{Binding MapVehiclesTip}"/>
                            </DockPanel>
                            <DockPanel Margin="18,0,0,4">
                                <TextBlock Text="Car ID" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <TextBox Text="{Binding MapVehicleIdFilter, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Car ID"
                                         ToolTip="Type a car's ID (e.g. 36293735): the map keeps only vehicles whose ID starts with it, labelled with their ID, and centres on the car once one is left. Empty = all vehicles."/>
                            </DockPanel>
                            <CheckBox Content="{Binding MapTracksLabel}" IsChecked="{Binding MapShowTracks}" Margin="0,0,0,2"
                                      ToolTip="Where tracked players went (Players tab → Tracking): a ring and time where a run starts, a dot and time where it ends. No line joins separate sessions."/>
                            <DockPanel Margin="18,0,0,4">
                                <TextBlock DockPanel.Dock="Right" Text="h" VerticalAlignment="Center" Margin="3,0,0,0"/>
                                <TextBox DockPanel.Dock="Right" Width="36" Text="{Binding MapTrackHours, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Track hours"
                                         ToolTip="How many hours back to draw; 0 or empty = everything" Margin="4,0,0,0"/>
                                <ComboBox ItemsSource="{Binding TrackChoices}" SelectedItem="{Binding MapTrackChoice}" DisplayMemberPath="Label" AutomationProperties.Name="Track player"/>
                            </DockPanel>
                            <CheckBox Content="Show saved locations" IsChecked="{Binding MapShowBookmarks}" Margin="0,0,0,8"/>
                            <TextBlock Text="Island overlays" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <CheckBox Content="{Binding MapThreatZonesLabel}" IsChecked="{Binding MapShowThreatZones}" Margin="0,0,0,2"
                                      ToolTip="The island's threat zones, where zombie/NPC hordes spawn: red = high threat (HTZ), amber = medium (MTZ). From the data bundled with SACC."/>
                            <CheckBox Content="{Binding MapHuntingAreasLabel}" IsChecked="{Binding MapShowHuntingAreas}" Margin="0,0,0,2"
                                      ToolTip="The island's hunting areas, where animals live (brown); purple = a mutant den. From the data bundled with SACC."/>
                            <CheckBox Content="{Binding MapPatrolPathsLabel}" IsChecked="{Binding MapShowPatrolPaths}" Margin="0,0,0,2"
                                      ToolTip="The routes the sentry mechs walk at military locations (orange dashed line, a dot at each spawner). From the data bundled with SACC."/>
                            <CheckBox Content="{Binding MapLocationsLabel}" IsChecked="{Binding MapShowLocations}" Margin="0,0,0,2"
                                      ToolTip="The island's place names (towns and POIs) at their centres. Names show as you zoom in. From the data bundled with SACC."/>
                            <CheckBox Content="Temperature (est.)" IsChecked="{Binding MapShowTemperature}" Margin="0,0,0,8"
                                      ToolTip="A rough average-temperature heatmap computed from the terrain grid's altitude (blue = cold high ground, red = warm low ground). A guess, like scum-map's; needs the bundled terrain grid."/>
                            <TextBlock Text="Teleport target" Style="{StaticResource SectionLabel}" Margin="0,0,0,4"/>
                            <ComboBox IsEditable="True" TextSearch.TextPath="SteamId" ItemsSource="{Binding Players}"
                                      Text="{Binding MapTarget, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,8"
                                      ToolTip="Who 'Teleport here' moves. Empty = you.">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate><TextBlock Text="{Binding Display}"/></DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>
                        <TextBlock DockPanel.Dock="Bottom" Text="{Binding MapStatus}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
                        <TabControl>
                            <TabItem Header="Layers">
                                <DockPanel Margin="0,4,0,0">
                                    <StackPanel DockPanel.Dock="Top">
                                        <TextBox Text="{Binding MapCategorySearch, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,4" ToolTip="Filter layers"/>
                                        <WrapPanel>
                                            <CheckBox IsChecked="{Binding MapAllLayers}" Content="All layers" FontWeight="Bold"
                                                      VerticalAlignment="Center" Margin="2,0,10,0"
                                                      AutomationProperties.Name="All layers"
                                                      ToolTip="Show or hide every map layer. Half-ticked when only some are shown."/>
                                            <Button Command="{Binding ShowAllMapCategoriesCommand}" Content="Show listed" MinWidth="0"/>
                                            <Button Command="{Binding HideAllMapCategoriesCommand}" Content="Hide listed" MinWidth="0"/>
                                        </WrapPanel>
                                    </StackPanel>
                                    <ListBox ItemsSource="{Binding MapCategoriesView}" VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.GroupStyle>
                                            <GroupStyle>
                                                <GroupStyle.HeaderTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding Items[0].SectionToggle.IsChecked}" Margin="2,6,0,2"
                                                                  AutomationProperties.Name="{Binding Name, StringFormat='Section {0}'}"
                                                                  ToolTip="Show or hide every layer in this section">
                                                            <TextBlock Text="{Binding Name}" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}"/>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </GroupStyle.HeaderTemplate>
                                            </GroupStyle>
                                        </ListBox.GroupStyle>
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox IsChecked="{Binding IsVisible}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Ellipse Width="10" Height="10" Margin="0,0,6,0" Stroke="Black" StrokeThickness="1"
                                                                 Fill="{Binding Category.Background}"/>
                                                        <TextBlock Text="{Binding Label}"/>
                                                    </StackPanel>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </TabItem>
                            <TabItem Header="GM spawn">
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,6,0,0">
                                <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,6"
                                           Text="Right-click a spot on the map → GM spawn here, or click a spot and press ▶."/>
                                <TextBlock Text="Ground height from (closest within 300 m)" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                                <DockPanel Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Content="Forget" Command="{Binding ForgetTerrainCommand}" Padding="6,0"
                                            ToolTip="Delete the loaded terrain grid (terrain.scgh)"/>
                                    <Button DockPanel.Dock="Right" Content="Load…" Command="{Binding LoadTerrainCommand}" Padding="6,0" Margin="0,0,4,0"
                                            ToolTip="Load a .scgh height grid made by SCUM Modding Studio's 'asset heights' command"/>
                                    <CheckBox IsChecked="{Binding GmHeightFromTerrain}" VerticalAlignment="Center"
                                              ToolTip="The game's own landscape heights, decoded by SCUM Modding Studio into a .scgh grid. When loaded this is the most accurate source and wins over everything but a Set height; the climb starts just below it.">
                                        <TextBlock Text="{Binding GmTerrainLabel}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,2">
                                    <Button DockPanel.Dock="Right" Content="Forget" Command="{Binding ForgetGroundCommand}" Padding="6,0"
                                            ToolTip="Delete every learned ground height (ground.json)"/>
                                    <CheckBox IsChecked="{Binding GmHeightFromLearned}" VerticalAlignment="Center"
                                              ToolTip="Ground measured by earlier NPC and zombie climbs. Within 30 m it beats the other sources, and the climb starts just below it.">
                                        <TextBlock Text="{Binding GmLearnedLabel}" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DockPanel>
                                <CheckBox Content="Nearest ground marker" IsChecked="{Binding GmHeightFromMarkers}" Margin="0,0,0,2"
                                          ToolTip="The right-clicked marker, or the nearest scum-map marker that has a height"/>
                                <CheckBox Content="My height" IsChecked="{Binding GmHeightFromMe}" Margin="0,0,0,2"
                                          ToolTip="Your last known position (Settings → your SteamID64; refresh Players to update it)"/>
                                <CheckBox Content="Nearest player height" IsChecked="{Binding GmHeightFromPlayers}" Margin="0,0,0,2"
                                          ToolTip="The nearest player's last known position, online or not"/>
                                <CheckBox IsChecked="{Binding GmHeightFromVehicles}" Margin="0,0,0,2"
                                          ToolTip="The nearest vehicle from the last #ListSpawnedVehicles output">
                                    <TextBlock Text="{Binding GmVehiclesLabel}" TextWrapping="Wrap"/>
                                </CheckBox>
                                <CheckBox Content="Nearest saved location height" IsChecked="{Binding GmHeightFromLocations}" Margin="0,0,0,2"
                                          ToolTip="The nearest bookmark on the Locations tab (its X Y Z)"/>
                                <DockPanel Margin="0,4,0,2">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding GmSetHeight, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding GmUseSetHeight}" AutomationProperties.Name="Set height value"/>
                                    <CheckBox Content="Set height (Z)" IsChecked="{Binding GmUseSetHeight}" VerticalAlignment="Center"
                                              ToolTip="Use this Z for every GM spawn and ignore the sources above"/>
                                </DockPanel>
                                <DockPanel Margin="0,2,0,6">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding GmHeightOffset, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="Height offset value"/>
                                    <TextBlock Text="Height offset (cm)" VerticalAlignment="Center"
                                               ToolTip="Added to whichever height is used; 100 = 1 m higher, negative = lower"/>
                                </DockPanel>
                                <CheckBox IsChecked="{Binding GmFindGround}" Margin="0,0,0,6"
                                          ToolTip="The game refuses an NPC or zombie spawn with no ground near its Z (once per NPC or zombie), and spawns it in mid-air when Z is high. With this on, NPC squads, zombie groups and beepers are sent from 30 m below the height guess upwards in 3 m steps; refused steps cost nothing, and the first accepted one is on the ground. If only some of a group are refused, just those go on to the next step. Needs SCUM's log (%LOCALAPPDATA%\SCUM\Saved\Logs). Animals and razors use the height as-is.">
                                    <TextBlock Text="Find the ground for NPCs and zombies (climb until the game accepts)" TextWrapping="Wrap"/>
                                </CheckBox>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBox DockPanel.Dock="Right" Width="110" Text="{Binding GmSpotterItem, UpdateSourceTrigger=LostFocus}"
                                             IsEnabled="{Binding GmSpotItems}" AutomationProperties.Name="Spotter item"
                                             ToolTip="Item id of the spotter; something cheap and harmless"/>
                                    <CheckBox IsChecked="{Binding GmSpotItems}" VerticalAlignment="Center"
                                              ToolTip="Kits here, and item and kit pins on the Missions tab, climb a spotter first: the spotter item is sent from below the height guess upwards like an NPC climb, and the gear goes where the game first answers 'Spawned' right after a refused step. If nothing is refused below it, that didn't show where the ground is, and the gear goes at the height guess. The spotter stays in the world; mission cleanup removes it. Needs SCUM's log.">
                                        <TextBlock Text="Place gear with a spotter" TextWrapping="Wrap"/>
                                    </CheckBox>
                                </DockPanel>
                                <DockPanel Margin="0,0,0,6">
                                    <TextBox DockPanel.Dock="Right" Width="80" Text="{Binding GmDespawnLifetime, UpdateSourceTrigger=LostFocus}"
                                             AutomationProperties.Name="Despawn lifetime seconds"
                                             ToolTip="DespawnLifetime in seconds added to NPC, zombie, animal and razor spawns from here (e.g. 3600 = 1h). Blank = don't add it; nothing is applied by default. Unverified in SCUM, so test in-game."/>
                                    <TextBlock Text="Despawn lifetime (s)" VerticalAlignment="Center"
                                               ToolTip="Seconds before the spawned NPCs/zombies/animals/razors despawn (e.g. 3600 = 1h). Blank = omit."/>
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding GmActions}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,3">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="78"/>
                                                    <ColumnDefinition Width="*"/>
                                                    <ColumnDefinition Width="42"/>
                                                    <ColumnDefinition Width="Auto"/>
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" VerticalAlignment="Center"/>
                                                <ComboBox Grid.Column="1" IsEditable="True" ItemsSource="{Binding Types}" Margin="0,0,4,0"
                                                          Text="{Binding Type, UpdateSourceTrigger=PropertyChanged}"
                                                          Visibility="{Binding HasType, Converter={StaticResource BoolToVisibility}}"/>
                                                <TextBox Grid.Column="2" Text="{Binding Count, UpdateSourceTrigger=PropertyChanged}" ToolTip="How many (1–50)"/>
                                                <Button Grid.Column="3" Content="▶" MinWidth="0" Padding="6,0" Margin="4,0,0,0"
                                                        Command="{Binding SpawnCommand}" CommandParameter="{Binding}"
                                                        AutomationProperties.Name="{Binding Label, StringFormat='Spawn {0}'}"
                                                        ToolTip="Spawn at the last clicked spot"/>
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                </StackPanel>
                                </ScrollViewer>
                            </TabItem>
                        </TabControl>
                    </DockPanel>

                    <DockPanel Grid.Column="2">
                        <Border DockPanel.Dock="Bottom" Background="{DynamicResource FieldBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1,0,1,1" Padding="8,6">
                            <DockPanel>
                                <WrapPanel DockPanel.Dock="Right">
                                    <Button Style="{StaticResource PrimaryButton}" Command="{Binding TeleportHereCommand}" Content="Teleport here" Margin="0,0,6,0"/>
                                    <Button Command="{Binding CopyTeleportCommand}" Content="Copy command" Margin="0,0,6,0"/>
                                    <Button Command="{Binding SaveHereCommand}" Content="Save location" Margin="0"/>
                                </WrapPanel>
                                <TextBlock Text="{Binding MapPointText}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            </DockPanel>
                        </Border>
                        <Grid>
                            <map:MapView x:Name="MapCanvas">
                                <map:MapView.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="GM spawn here" ItemsSource="{Binding GmActions}">
                                            <MenuItem.ItemContainerStyle>
                                                <Style TargetType="MenuItem">
                                                    <Setter Property="Header" Value="{Binding MenuHeader}"/>
                                                    <Setter Property="Command" Value="{Binding SpawnCommand}"/>
                                                    <Setter Property="CommandParameter" Value="{Binding}"/>
                                                </Style>
                                            </MenuItem.ItemContainerStyle>
                                        </MenuItem>
                                        <MenuItem Header="{Binding GmHeightText}" IsEnabled="False"/>
                                        <Separator/>
                                        <MenuItem Header="Teleport target here" Command="{Binding TeleportHereCommand}"/>
                                        <MenuItem Header="Copy teleport command" Command="{Binding CopyTeleportCommand}"/>
                                        <MenuItem Header="Save as location" Command="{Binding SaveHereCommand}"/>
                                        <MenuItem Header="WhalleyBot">
                                            <MenuItem Header="Copy X Y Z (panel location fields)" Command="{Binding CopySpotLineCommand}" CommandParameter="xyz"/>
                                            <MenuItem Header="Copy #location &quot;X Y Z&quot;" Command="{Binding CopySpotLineCommand}" CommandParameter="location"/>
                                            <MenuItem Header="Copy #map X Y Z" Command="{Binding CopySpotLineCommand}" CommandParameter="map"/>
                                            <MenuItem Header="Copy #spawnrazor here" Command="{Binding CopySpotLineCommand}" CommandParameter="razor"/>
                                            <MenuItem Header="Copy #spawnarmedNPC here" Command="{Binding CopySpotLineCommand}" CommandParameter="npc"/>
                                            <Separator/>
                                            <MenuItem Header="{Binding AddCoordHeader}" Command="{Binding AddCoordCommand}"/>
                                            <MenuItem Header="{Binding CopyCoordsHeader}" Command="{Binding CopyCoordsCommand}"/>
                                            <MenuItem Header="Clear coordinate list" Command="{Binding ClearCoordsCommand}"/>
                                        </MenuItem>
                                        <Separator/>
                                        <MenuItem Header="View this spot on scum-map.com" Click="ViewOnScumMap_Click"/>
                                    </ContextMenu>
                                </map:MapView.ContextMenu>
                            </map:MapView>
                            <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8" Padding="6,3" CornerRadius="3"
                                    Background="#B0000000" IsHitTestVisible="False"
                                    Visibility="{Binding MapHover, Converter={StaticResource NotEmptyToVisibility}}">
                                <TextBlock Text="{Binding MapHover}" Foreground="White" FontFamily="Cascadia Mono, Consolas"/>
                            </Border>
                            <!-- Attribution: a condition of NOTIMEO's permission. Keep it visible whenever their layers show. -->
                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="6" Padding="6,2" CornerRadius="3" Background="#D0FFFFFF">
                                <TextBlock>
                                    <Hyperlink Command="{Binding OpenScumMapCommand}" ToolTip="Map tiles and layers by scum-map.com, shown with permission. Opens scum-map.com.">
                                        Map © scum-map.com
                                    </Hyperlink>
                                </TextBlock>
                            </Border>
                        </Grid>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Missions -->
            <TabItem Header="Missions" x:Name="MissionTab">
                <Grid PreviewKeyDown="MissionTab_PreviewKeyDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" MinWidth="150"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="*" MinWidth="240"/>
                        <ColumnDefinition Width="6"/>
                        <ColumnDefinition Width="320" MinWidth="260"/>
                    </Grid.ColumnDefinitions>
                    <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ToolTip="Drag to resize"/>
                    <GridSplitter Grid.Column="3" Width="6" HorizontalAlignment="Stretch" Background="Transparent" ToolTip="Drag to resize"/>

                    <!-- Left: which mission, and its phases in order -->
                    <DockPanel Grid.Column="0">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="Mission" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                            <ComboBox ItemsSource="{Binding Missions}" SelectedItem="{Binding SelectedMission}" DisplayMemberPath="Name" AutomationProperties.Name="Mission"/>
                            <DockPanel Margin="0,4,0,0">
                                <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Command="{Binding DeleteMissionCommand}" Content="Delete"/>
                                <Button Style="{StaticResource PrimaryButton}" Command="{Binding NewMissionCommand}" Content="New" HorizontalAlignment="Left"/>
                            </DockPanel>
                            <TextBox Text="{Binding SelectedMission.Name, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding HasMission}" Margin="0,4,0,0"
                                     AutomationProperties.Name="Mission name" ToolTip="The mission's name"/>
                            <TextBlock Text="Phases" Style="{StaticResource SectionLabel}" Margin="0,8,0,2"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Bottom">
                            <WrapPanel Margin="0,4,0,0">
                                <Button Command="{Binding AddPhaseCommand}" Content="Add"/>
                                <Button Command="{Binding PhaseUpCommand}" Content="▲" MinWidth="0" AutomationProperties.Name="Move phase up"/>
                                <Button Command="{Binding PhaseDownCommand}" Content="▼" MinWidth="0" AutomationProperties.Name="Move phase down"/>
                                <Button Style="{StaticResource DangerButton}" Command="{Binding RemovePhaseCommand}" Content="Remove"/>
                            </WrapPanel>
                            <TextBlock Text="WhalleyBot script" Style="{StaticResource SectionLabel}" Margin="0,8,0,2"/>
                            <WrapPanel>
                                <Button Command="{Binding CopyMissionScriptCommand}" Content="Copy" ToolTip="Copies one task block per phase. Radius rules become comments, because a task sends every line when it starts."/>
                                <Button Command="{Binding SaveMissionScriptCommand}" Content="Save…" ToolTip="Saves the same text to a file"/>
                            </WrapPanel>
                        </StackPanel>
                        <ListBox ItemsSource="{Binding SelectedMission.Phases}" SelectedItem="{Binding SelectedPhase}" DisplayMemberPath="Name" AutomationProperties.Name="Phases"/>
                    </DockPanel>

                    <!-- Middle: the map and its tools -->
                    <DockPanel Grid.Column="2">
                        <WrapPanel DockPanel.Dock="Top" IsEnabled="{Binding HasMission}">
                            <RadioButton GroupName="MissionTool" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding ToolSelect}" Content="Select" Padding="8,3" Margin="0,0,2,4"/>
                            <RadioButton GroupName="MissionTool" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding ToolCentre}" Content="Centre" Padding="8,3" Margin="0,0,2,4"
                                         ToolTip="Click the map to set this phase's centre"/>
                            <RadioButton GroupName="MissionTool" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding ToolSpawn}" Content="Spawn" Padding="8,3" Margin="0,0,2,4"
                                         ToolTip="Click the map to place spawns"/>
                            <RadioButton GroupName="MissionTool" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding ToolPrefab}" Content="Prefab" Padding="8,3" Margin="0,0,2,4"
                                         ToolTip="Click the map to place the selected prefab scene"/>
                            <RadioButton GroupName="MissionTool" Style="{StaticResource {x:Type ToggleButton}}" IsChecked="{Binding ToolMove}" Content="Move" Padding="8,3" Margin="0,0,12,4"
                                         ToolTip="Click the map to move the selected spawn"/>
                            <Button Command="{Binding PrevPhaseCommand}" Content="◀" MinWidth="0" Margin="0,0,2,4" AutomationProperties.Name="Previous phase" ToolTip="Previous phase"/>
                            <Button Command="{Binding NextPhaseCommand}" Content="▶" MinWidth="0" Margin="0,0,6,4" AutomationProperties.Name="Next phase" ToolTip="Next phase"/>
                            <TextBlock Text="{Binding PhasePosition}" VerticalAlignment="Center" Margin="0,0,0,4" Style="{StaticResource Muted}"/>
                        </WrapPanel>
                        <TextBlock DockPanel.Dock="Top" Text="{Binding MissionHint}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <Border DockPanel.Dock="Bottom" Padding="0,4,0,0">
                            <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap"
                                       Text="Pins: ● creature  ▬ vehicle  ■ item or kit. Grey = not spawned, green = spawned, amber = some refused, red = refused, blue = sent, not confirmed. Yellow dashes = trigger radius, red dots = hold radius."/>
                        </Border>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                            <map:MapView x:Name="MissionCanvas"/>
                        </Border>
                    </DockPanel>

                    <!-- Right: plan or run the selected phase -->
                    <TabControl Grid.Column="4" IsEnabled="{Binding HasMission}">
                        <TabItem Header="Plan">
                            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                                <StackPanel Margin="0,6,4,0">
                                    <StackPanel IsEnabled="{Binding HasPhase}">
                                        <TextBlock Text="Phase" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                                        <TextBox Text="{Binding SelectedPhase.Name, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Phase name" ToolTip="The phase's name"/>
                                        <TextBlock Text="{Binding SelectedPhase.CenterText}" Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,3,0,3"/>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Radius (m)" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding SelectedPhase.RadiusM, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Phase radius in metres"
                                                     ToolTip="The phase's area, and how far its cleanup reaches"/>
                                        </DockPanel>
                                        <DockPanel Margin="0,0,0,3">
                                            <TextBlock Text="Announce" VerticalAlignment="Center" Width="80"/>
                                            <TextBox Text="{Binding SelectedPhase.Announce, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Phase announcement"
                                                     ToolTip="Sent as #Announce when the phase starts. Empty = nothing."/>
                                        </DockPanel>

                                        <TextBlock Text="Spawns in this phase" Style="{StaticResource SectionLabel}" Margin="0,8,0,2"/>
                                        <ListBox ItemsSource="{Binding SelectedPhase.Spawns}" SelectedItem="{Binding SelectedSpawn}" MaxHeight="130" MinHeight="48"
                                                 AutomationProperties.Name="Spawns in this phase" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                            <ListBox.ItemTemplate>
                                                <DataTemplate>
                                                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis" ToolTip="{Binding RuleText}"/>
                                                </DataTemplate>
                                            </ListBox.ItemTemplate>
                                        </ListBox>
                                    </StackPanel>

                                    <DockPanel Margin="0,8,0,2">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource DangerButton}" Command="{Binding RemoveSpawnCommand}" Content="Remove" Margin="0"/>
                                        <TextBlock Text="{Binding EditSpawnHeading}" Style="{StaticResource SectionLabel}" VerticalAlignment="Center" Margin="0"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Kind" VerticalAlignment="Center" Width="80"/>
                                        <ComboBox ItemsSource="{Binding MissionKinds}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding EditSpawn.Kind}" AutomationProperties.Name="Spawn kind"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Type" VerticalAlignment="Center" Width="80"/>
                                        <ComboBox IsEditable="True" ItemsSource="{Binding EditSpawnTypes}" Text="{Binding EditSpawn.Type, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Spawn type"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="How many" VerticalAlignment="Center" Width="80"/>
                                        <TextBox Text="{Binding EditSpawn.Count, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Spawn count"/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Trigger (m)" VerticalAlignment="Center" Width="80"/>
                                        <TextBox Text="{Binding EditSpawn.TriggerRadiusM, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Trigger radius in metres"
                                                 ToolTip="Wait until a player comes this close. 0 = spawn as soon as the phase starts."/>
                                    </DockPanel>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Hold (m)" VerticalAlignment="Center" Width="80"/>
                                        <TextBox Text="{Binding EditSpawn.HoldRadiusM, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Hold radius in metres"
                                                 ToolTip="Don't spawn while a player is this close, so nothing appears on top of them. 0 = no check."/>
                                    </DockPanel>
                                    <TextBlock Text="{Binding EditSpawn.RuleText}" Style="{StaticResource Muted}" TextWrapping="Wrap"/>

                                    <TextBlock Text="Prefab scenes" Style="{StaticResource SectionLabel}" Margin="0,10,0,2"/>
                                    <ComboBox ItemsSource="{Binding MissionPrefabs}" SelectedItem="{Binding SelectedPrefab}" DisplayMemberPath="Name" AutomationProperties.Name="Prefab"/>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Command="{Binding NewPrefabCommand}" Content="New"/>
                                        <Button Style="{StaticResource DangerButton}" Command="{Binding DeletePrefabCommand}" Content="Delete"/>
                                        <Button Command="{Binding AddPrefabMemberCommand}" Content="Add member"/>
                                    </WrapPanel>
                                    <TextBox Text="{Binding SelectedPrefab.Name, UpdateSourceTrigger=PropertyChanged}" Margin="0,4,0,4" AutomationProperties.Name="Prefab name" ToolTip="The prefab's name"/>
                                    <ItemsControl ItemsSource="{Binding SelectedPrefab.Members}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="4" Margin="0,0,0,4">
                                                    <StackPanel>
                                                        <DockPanel Margin="0,0,0,3">
                                                            <Button DockPanel.Dock="Right" Content="✕" MinWidth="0" Margin="4,0,0,0" AutomationProperties.Name="Remove member" ToolTip="Remove this member"
                                                                    Command="{Binding DataContext.RemovePrefabMemberCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}" CommandParameter="{Binding}"/>
                                                            <ComboBox ItemsSource="{Binding DataContext.MissionKinds, RelativeSource={RelativeSource AncestorType=ItemsControl}}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding Kind}" AutomationProperties.Name="Member kind"/>
                                                        </DockPanel>
                                                        <TextBox Text="{Binding Type, UpdateSourceTrigger=LostFocus}" Margin="0,0,0,3" AutomationProperties.Name="Member type" ToolTip="Spawn code, e.g. BPC_Rager or BP_Drifter_Lvl_5"/>
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/>
                                                            </Grid.ColumnDefinitions>
                                                            <TextBlock Grid.Column="0" Text="Each" VerticalAlignment="Center" Margin="0,0,3,0"/>
                                                            <TextBox Grid.Column="1" Text="{Binding Count, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Member count per pin" ToolTip="How many each pin spawns"/>
                                                            <TextBlock Grid.Column="2" Text="Pins" VerticalAlignment="Center" Margin="6,0,3,0"/>
                                                            <TextBox Grid.Column="3" Text="{Binding Copies, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Member pins" ToolTip="How many pins, spaced evenly in a ring"/>
                                                            <TextBlock Grid.Column="4" Text="Ring m" VerticalAlignment="Center" Margin="6,0,3,0"/>
                                                            <TextBox Grid.Column="5" Text="{Binding OffsetM, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Member ring radius in metres" ToolTip="The ring's radius; 0 = on the spot you click"/>
                                                        </Grid>
                                                    </StackPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Text="Placed pins take the Trigger and Hold set under Next spawn."/>
                                </StackPanel>
                            </ScrollViewer>
                        </TabItem>
                        <TabItem Header="Run">
                            <DockPanel Margin="0,6,4,0" IsEnabled="{Binding HasPhase}">
                                <StackPanel DockPanel.Dock="Top">
                                    <WrapPanel>
                                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunPhaseCommand}" Content="▶ Run this phase" IsEnabled="{Binding MissionNotRunning}"/>
                                        <Button Command="{Binding StopRunCommand}" Content="■ Stop"/>
                                    </WrapPanel>
                                    <TextBlock Text="{Binding RunStatus}" TextWrapping="Wrap" Margin="0,4,0,4"/>
                                    <DockPanel Margin="0,0,0,3">
                                        <TextBlock Text="Read players every (s)" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                        <TextBox Text="{Binding MissionPoll, UpdateSourceTrigger=LostFocus}" AutomationProperties.Name="Player read interval in seconds"
                                                 ToolTip="5 or more. Only used while spawns are waiting on player positions, and each read types into the game."/>
                                    </DockPanel>
                                    <CheckBox Content="Ignore me (my SteamID64 in Settings)" IsChecked="{Binding MissionIgnoreMe}" Margin="0,0,0,6"
                                              ToolTip="Your own character doesn't set off or hold spawns"/>
                                    <TextBlock Text="Spawns in this phase" Style="{StaticResource SectionLabel}" Margin="0,0,0,2"/>
                                    <ListBox ItemsSource="{Binding SelectedPhase.Spawns}" SelectedItem="{Binding SelectedSpawn}" MaxHeight="150" MinHeight="48"
                                             AutomationProperties.Name="Spawn results" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Summary}" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Text="{Binding StateText}" Style="{StaticResource Muted}" TextTrimming="CharacterEllipsis"/>
                                                </StackPanel>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="Spawned so far, this mission" Style="{StaticResource SectionLabel}" Margin="0,8,0,2"/>
                                </StackPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <TextBlock Style="{StaticResource Muted}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Text="These count what the game accepted, not what's still alive: the game doesn't report kills. Unsure = sent, and the game said nothing either way."/>
                                    <TextBlock Text="When the phase is over" Style="{StaticResource SectionLabel}" Margin="0,8,0,2"/>
                                    <TextBox Text="{Binding SelectedPhase.ExtraCleanup, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" MinHeight="44" MaxHeight="80" VerticalScrollBarVisibility="Auto"
                                             AutomationProperties.Name="Extra cleanup commands" ToolTip="Your own # commands to add to this phase's cleanup, one per line"/>
                                    <WrapPanel Margin="0,4,0,0">
                                        <Button Style="{StaticResource DangerButton}" Command="{Binding CleanupPhaseCommand}" Content="Clean up…"
                                                ToolTip="Teleports you to the phase centre and destroys the item types this phase spawned. It shows the commands first."/>
                                        <Button Command="{Binding ResetRunCommand}" Content="Reset phase…" ToolTip="Forget what this phase spawned, so it can run again"/>
                                    </WrapPanel>
                                </StackPanel>
                                <DataGrid ItemsSource="{Binding MissionTally}" AutoGenerateColumns="False" IsReadOnly="True" HeadersVisibility="Column" AutomationProperties.Name="Spawn tally by type" MinHeight="60">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="*" MinWidth="90"/>
                                        <DataGridTextColumn Header="Asked" Binding="{Binding Asked}" Width="Auto"/>
                                        <DataGridTextColumn Header="Spawned" Binding="{Binding Spawned}" Width="Auto"/>
                                        <DataGridTextColumn Header="Refused" Binding="{Binding Refused}" Width="Auto"/>
                                        <DataGridTextColumn Header="Unsure" Binding="{Binding Unconfirmed}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </DockPanel>
                        </TabItem>
                    </TabControl>
                </Grid>
            </TabItem>
            <!-- ============================================================ Locations -->
            <TabItem Header="Locations">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Command="{Binding AddBookmarkCommand}" Content="Add"/>
                        <Button Command="{Binding CaptureLocationCommand}" Content="{Binding CaptureLocationLabel}"
                                ToolTip="Sends #Location &lt;target&gt; true and saves the coordinates it returns. With no target it captures your own location."/>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteBookmarkCommand}" Content="Delete"/>
                        <TextBlock Text="Target:" VerticalAlignment="Center" Margin="12,0,6,6"/>
                        <TextBox Width="200" Margin="0,0,6,6" Text="{Binding BookmarkTarget, UpdateSourceTrigger=PropertyChanged}"
                                 ToolTip="SteamID64 or name of the player to move. Empty = you."/>
                        <Button Style="{StaticResource PrimaryButton}" Command="{Binding TeleportBookmarkCommand}" Content="Teleport target here"/>
                    </WrapPanel>
                    <DataGrid x:Name="BookmarksGrid" ItemsSource="{Binding Bookmarks}" SelectedItem="{Binding SelectedBookmark}" CellEditEnding="Bookmarks_CellEditEnding"
                              RowEditEnding="BookmarksGrid_RowEditEnding">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                            <DataGridTextColumn Header="Sector" Binding="{Binding Converter={StaticResource Sector}}" Width="60" IsReadOnly="True"/>
                            <DataGridTextColumn Header="X" Binding="{Binding X}" Width="110"/>
                            <DataGridTextColumn Header="Y" Binding="{Binding Y}" Width="110"/>
                            <DataGridTextColumn Header="Z" Binding="{Binding Z}" Width="110"/>
                            <DataGridTextColumn Header="Notes" Binding="{Binding Notes}" Width="3*"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ Macros -->
            <TabItem Header="Macros">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="240"/>
                        <ColumnDefinition Width="12"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <Button Command="{Binding NewMacroCommand}" Content="New"/>
                            <Button Style="{StaticResource DangerButton}" Command="{Binding DeleteMacroCommand}" Content="Delete"/>
                        </WrapPanel>
                        <ListBox ItemsSource="{Binding Macros}" SelectedItem="{Binding SelectedMacro}" DisplayMemberPath="Name"/>
                    </DockPanel>
                    <DockPanel Grid.Column="2" Visibility="{Binding SelectedMacro, Converter={StaticResource NotEmptyToVisibility}}">
                        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,6">
                            <TextBlock Text="Name:" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBox Text="{Binding SelectedMacro.Name, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <WrapPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                            <TextBlock Text="{}{player} =" VerticalAlignment="Center" Margin="0,0,6,6"/>
                            <TextBox Width="200" Margin="0,0,6,6" Text="{Binding MacroTarget, UpdateSourceTrigger=PropertyChanged}"/>
                            <Button Command="{Binding CheckMacroCommand}" Content="Check"/>
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding RunMacroCommand}" Content="Run"/>
                            <Button Command="{Binding CopyMacroAsTaskCommand}" Content="Copy as WhalleyBot task"
                                    ToolTip="wait → #taskpause, {player} → &lt;argument&gt; (the buyer's SteamID when a pack runs #ftask name [SteamID]), {me} → your SteamID64"/>
                        </WrapPanel>
                        <TextBox Text="{Binding SelectedMacro.Script, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" AcceptsTab="True"
                                 VerticalContentAlignment="Top" VerticalScrollBarVisibility="Auto" FontFamily="Cascadia Mono, Consolas"/>
                    </DockPanel>
                </Grid>
            </TabItem>

            <!-- ============================================================ Log -->
            <TabItem Header="Log">
                <DockPanel>
                    <WrapPanel DockPanel.Dock="Top">
                        <Button Command="{Binding ResendCommand}" CommandParameter="{Binding SelectedItem, ElementName=HistoryGrid}" Content="Resend"/>
                        <Button Command="{Binding ToFreeformCommand}" CommandParameter="{Binding SelectedItem, ElementName=HistoryGrid}" Content="Edit in console"/>
                        <Button Style="{StaticResource DangerButton}" Command="{Binding ClearHistoryCommand}" Content="Clear"/>
                    </WrapPanel>
                    <DataGrid x:Name="HistoryGrid" ItemsSource="{Binding History}" IsReadOnly="True">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Time" Binding="{Binding Time, StringFormat='MMM d HH:mm:ss'}" Width="120"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="160"/>
                            <DataGridTextColumn Header="Command" Binding="{Binding Text}" Width="*" FontFamily="Cascadia Mono, Consolas"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================================================ Settings -->
            <TabItem Header="Settings">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <Grid MaxWidth="760" HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="230"/>
                            <ColumnDefinition Width="260"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <Grid.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="VerticalAlignment" Value="Center"/>
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                            <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                            </Style>
                            <Style TargetType="CheckBox">
                                <Setter Property="Margin" Value="0,0,0,8"/>
                                <Setter Property="VerticalAlignment" Value="Center"/>
                            </Style>
                        </Grid.Resources>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Text="Your SteamID64"/>
                        <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding Settings.MySteamId}"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="  default target for self-commands" Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock Grid.Row="1" Text="Game process name"/>
                        <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding Settings.ProcessName}"/>

                        <TextBlock Grid.Row="2" Text="Open-chat key"/>
                        <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Settings.ChatKey}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="  WPF key name: T, Enter, Oem2…" Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock Grid.Row="3" Text="Input mode"/>
                        <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,0,8" ItemsSource="{Binding InputModes}" SelectedItem="{Binding Settings.InputMode}"/>
                        <TextBlock Grid.Row="3" Grid.Column="2" Text="  Paste is fastest; Type if paste fails" Foreground="{DynamicResource MutedBrush}"/>

                        <TextBlock Grid.Row="4" Text="Delay after focusing game (ms)"/>
                        <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding Settings.FocusDelayMs}"/>
                        <TextBlock Grid.Row="5" Text="Delay after opening chat (ms)"/>
                        <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding Settings.ChatOpenDelayMs}"/>
                        <TextBlock Grid.Row="6" Text="Delay before Enter (ms)"/>
                        <TextBox Grid.Row="6" Grid.Column="1" Text="{Binding Settings.BeforeEnterDelayMs}"/>
                        <TextBlock Grid.Row="7" Text="Delay between commands (ms)"/>
                        <TextBox Grid.Row="7" Grid.Column="1" Text="{Binding Settings.AfterSendDelayMs}"/>
                        <TextBlock Grid.Row="8" Text="Clipboard reply timeout (ms)"/>
                        <TextBox Grid.Row="8" Grid.Column="1" Text="{Binding Settings.ClipboardCaptureTimeoutMs}"/>

                        <TextBlock Grid.Row="19" Text="Colour scheme"/>
                        <ComboBox Grid.Row="19" Grid.Column="1" Margin="0,8,0,0" ItemsSource="{Binding ThemeNames}" SelectedItem="{Binding Theme}"/>
                        <TextBlock Grid.Row="19" Grid.Column="2" Text="  header &amp; accent colours" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Bottom" Margin="0,0,0,2"/>

                        <TextBlock Grid.Row="14" Text="Max amount per spawn line"/>
                        <TextBox Grid.Row="14" Grid.Column="1" Text="{Binding Settings.MaxSpawnPerCommand}"/>
                        <TextBlock Grid.Row="14" Grid.Column="2" Text="  kits split bigger counts (10 matches SAH)" Foreground="{DynamicResource MutedBrush}"/>

                        <CheckBox Grid.Row="15" Grid.ColumnSpan="3" IsChecked="{Binding Settings.ChatStaysOpenAfterSend}"
                                  Content="Game chat stays open after Enter (SCUM does): open chat once per batch, press Escape at the end"/>
                        <TextBlock Grid.Row="16" Text="Delay after closing chat (ms)"/>
                        <TextBox Grid.Row="16" Grid.Column="1" Text="{Binding Settings.CloseDelayMs}"/>
                        <TextBlock Grid.Row="17" Text="&quot;Full&quot; StackCount"/>
                        <TextBox Grid.Row="17" Grid.Column="1" Text="{Binding Settings.FullStackCount}"/>
                        <TextBlock Grid.Row="17" Grid.Column="2" Text="  sent when Full is ticked; the game caps overflow" Foreground="{DynamicResource MutedBrush}"/>
                        <TextBlock Grid.Row="18" Text="Magazine pattern (regex)"/>
                        <TextBox Grid.Row="18" Grid.Column="1" Text="{Binding Settings.MagazinePattern}" FontFamily="Cascadia Mono, Consolas"/>
                        <TextBlock Grid.Row="18" Grid.Column="2" Text="  which codes a kit's 'Fill magazines' fills" Foreground="{DynamicResource MutedBrush}"/>

                        <CheckBox Grid.Row="9" Grid.ColumnSpan="3" IsChecked="{Binding Settings.RestoreClipboard}" Content="Restore my clipboard text after sending"/>
                        <CheckBox Grid.Row="10" Grid.ColumnSpan="3" IsChecked="{Binding Settings.ReturnFocusToSacc}" Content="Switch back to SACC after sending"/>
                        <CheckBox Grid.Row="11" Grid.ColumnSpan="3" IsChecked="{Binding Settings.ConfirmDangerous}" Content="Confirm kick / ban / destroy-all commands"/>

                        <WrapPanel Grid.Row="12" Grid.ColumnSpan="3" Margin="0,8,0,0">
                            <Button Style="{StaticResource PrimaryButton}" Command="{Binding SaveSettingsCommand}" Content="Save settings"/>
                            <Button Command="{Binding EditCatalogCommand}" Content="Edit command catalog"/>
                            <Button Command="{Binding ReloadCatalogCommand}" Content="Reload catalog"/>
                            <Button Command="{Binding OpenDataFolderCommand}" Content="Open data folder"/>
                            <Button Command="{Binding OpenIconsFolderCommand}" Content="Open icons folder"
                                    ToolTip="Put your own &lt;SpawnCode&gt;.png screenshots here; they override the bundled icons"/>
                            <Button Command="{Binding ReloadIconsCommand}" Content="Reload icons"/>
                            <Button Command="{Binding RelaunchAsAdminCommand}" Content="Restart as administrator"/>
                        </WrapPanel>
                        <TextBlock Grid.Row="13" Grid.ColumnSpan="3" Foreground="{DynamicResource MutedBrush}" TextWrapping="Wrap" Margin="0,8,0,0"
                                   Text="SACC sends commands by focusing the SCUM window, opening chat, and pasting or typing the line. If SCUM runs as administrator, SACC must too, or Windows will block the keystrokes. Commands marked Conflicting or Unverified in the catalog may need their template adjusted for the current game version."/>
                    </Grid>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
