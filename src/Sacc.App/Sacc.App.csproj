<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sacc.Core\Sacc.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SACC</AssemblyName>
    <RootNamespace>Sacc.App</RootNamespace>
    <Version>0.1.0</Version>
    <Product>SACC - SCUM Admin Command Console</Product>
    <Authors>Lurid Phoenix and Maddog Murphy</Authors>
    <Description>Clean-room admin command console for SCUM servers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\data\commands.json" Link="data\commands.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
