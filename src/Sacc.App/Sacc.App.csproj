<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Sacc.Core\Sacc.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>SACC</AssemblyName>
    <RootNamespace>Sacc.App</RootNamespace>
    <Version>0.4.25</Version>
    <Product>SACC - SCUM Admin Command Console</Product>
    <Authors>Lurid Phoenix and Maddog Murphy</Authors>
    <Description>Clean-room admin command console for SCUM servers.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\..\data\*.json" Link="data\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\icons\*.png" Link="data\icons\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Optional bundled terrain grid; the glob matches nothing until a terrain.scgh is dropped in.
         ExcludeFromSingleFile keeps it a loose file next to the exe (so AppPaths.BundledTerrain finds it);
         the single-file publisher otherwise embeds this unknown binary extension into SACC.exe. -->
    <Content Include="..\..\data\terrain\*.scgh" Link="data\terrain\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <ExcludeFromSingleFile>true</ExcludeFromSingleFile>
    </Content>
    <Content Include="..\..\data\terrain\NOTICE.txt" Link="data\terrain\NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <!-- Bundled island map overlays (threat zones, hunting areas); the glob matches nothing until one is generated. -->
    <Content Include="..\..\data\mapfeatures\*.json" Link="data\mapfeatures\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\data\mapfeatures\NOTICE.txt" Link="data\mapfeatures\NOTICE.txt">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
