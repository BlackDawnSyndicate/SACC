<Application x:Class="Sacc.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:infra="clr-namespace:Sacc.App.Infrastructure"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="HeaderBrush" Color="#1F2A30"/>
        <SolidColorBrush x:Key="AccentBrush" Color="#C8641E"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#6B7780"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F4F5F6"/>
        <SolidColorBrush x:Key="ErrorBrush" Color="#B3261E"/>
        <SolidColorBrush x:Key="OkBrush" Color="#2E7D32"/>
        <SolidColorBrush x:Key="TextBrush" Color="#23292E"/>
        <SolidColorBrush x:Key="FieldBrush" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="BorderBrush" Color="#DADFE2"/>

        <infra:ConfidenceBrushConverter x:Key="ConfidenceBrush"/>
        <infra:NotEmptyToVisibilityConverter x:Key="NotEmptyToVisibility"/>
        <infra:InverseBoolConverter x:Key="InverseBool"/>
        <infra:SectorConverter x:Key="Sector"/>
        <infra:CodeToIconConverter x:Key="CodeToIcon"/>
        <infra:UnlistedCodeVisibilityConverter x:Key="UnlistedCode"/>

        <!-- A spawn code with its in-game thumbnail (blank square when no icon is known). -->
        <DataTemplate x:Key="CodeWithIcon">
            <StackPanel Orientation="Horizontal">
                <Border Width="32" Height="32" Margin="0,1,8,1" Background="#1F2A30" CornerRadius="3">
                    <Image Source="{Binding Converter={StaticResource CodeToIcon}}" Stretch="Uniform"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                </Border>
                <TextBlock Text="{Binding}" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas"/>
                <TextBlock Text="not in #ListItems" VerticalAlignment="Center" Margin="8,0,0,0" FontStyle="Italic" Foreground="{StaticResource MutedBrush}"
                           Visibility="{Binding Converter={StaticResource UnlistedCode}}"
                           ToolTip="The game's own item list doesn't have this code: a DLC item, or renamed or removed in an update. It may not spawn."/>
            </StackPanel>
        </DataTemplate>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>

        <Style TargetType="Button">
            <Setter Property="Padding" Value="10,4"/>
            <Setter Property="Margin" Value="0,0,6,6"/>
            <Setter Property="MinWidth" Value="70"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{StaticResource AccentBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
        </Style>
        <Style x:Key="DangerButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{StaticResource ErrorBrush}"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="4,3"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
        <Style x:Key="SectionLabel" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Margin" Value="0,8,0,4"/>
        </Style>
        <Style x:Key="Muted" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <Style x:Key="Mono" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Cascadia Mono, Consolas"/>
        </Style>
        <Style TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="False"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="HorizontalGridLinesBrush" Value="#E3E6E8"/>
            <Setter Property="RowHeaderWidth" Value="0"/>
            <Setter Property="SelectionMode" Value="Single"/>
            <Setter Property="CanUserAddRows" Value="False"/>
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="RowBackground" Value="{StaticResource FieldBrush}"/>
        </Style>
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource FieldBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="DataGridCell">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
        </Style>
    </Application.Resources>
</Application>
