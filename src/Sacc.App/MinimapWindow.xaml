<Window x:Class="Sacc.App.MinimapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:map="clr-namespace:Sacc.App.Map"
        Title="SACC minimap" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        Width="280" Height="280" MinWidth="150" MinHeight="150">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4">
        <DockPanel LastChildFill="True">
            <!-- drag strip -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Height="22"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Position" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextBrush}"/>
                <Button Content="✕" Click="Hide_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        MinWidth="0" Padding="6,0" Margin="0,0,2,0" BorderThickness="0" Background="Transparent"
                        ToolTip="Hide the minimap (toggle it back on in Settings)"/>
            </Grid>
            <!-- scum-map attribution (required): a visible, linked credit back to the source -->
            <TextBlock DockPanel.Dock="Bottom" Margin="6,2,6,3" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right">
                <Hyperlink NavigateUri="https://scum-map.com" RequestNavigate="Link_RequestNavigate"
                           Foreground="{DynamicResource MutedBrush}">Map © scum-map.com</Hyperlink>
            </TextBlock>
            <map:MapView x:Name="MiniMap"/>
        </DockPanel>
    </Border>
</Window>
