<Window x:Class="Sacc.App.MinimapWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:map="clr-namespace:Sacc.App.Map"
        Title="SACC minimap" WindowStyle="None" ResizeMode="CanResizeWithGrip" ShowInTaskbar="False"
        Topmost="True" ShowActivated="False" AllowsTransparency="True" Background="Transparent"
        Width="280" Height="280" MinWidth="150" MinHeight="150">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1" CornerRadius="4">
        <DockPanel LastChildFill="True">
            <!-- drag strip -->
            <Grid x:Name="TitleBar" DockPanel.Dock="Top" Background="{DynamicResource HeaderBrush}" Height="22"
                  MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <TextBlock Text="Position" Margin="8,0,0,0" VerticalAlignment="Center" FontSize="11"
                           Foreground="{DynamicResource TextBrush}"/>
                <Button Content="✕" Click="Hide_Click" HorizontalAlignment="Right" VerticalAlignment="Center"
                        MinWidth="0" Padding="6,0" Margin="0,0,2,0" BorderThickness="0" Background="Transparent"
                        ToolTip="Hide the minimap (toggle it back on in Settings)"/>
            </Grid>
            <!-- scum-map attribution (required): a visible, linked credit back to the source -->
            <TextBlock DockPanel.Dock="Bottom" Margin="6,2,6,3" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                       HorizontalAlignment="Right">
                <Hyperlink NavigateUri="https://scum-map.com" RequestNavigate="Link_RequestNavigate"
                           Foreground="{DynamicResource MutedBrush}">Map © scum-map.com</Hyperlink>
            </TextBlock>
            <!-- The map is scaled up a little so that, when rotated to the heading, its corners still cover the view. -->
            <Grid ClipToBounds="True">
                <map:MapView x:Name="MiniMap" RenderTransformOrigin="0.5,0.5">
                    <map:MapView.RenderTransform>
                        <TransformGroup>
                            <ScaleTransform ScaleX="1.45" ScaleY="1.45"/>
                            <RotateTransform x:Name="MapRotate" Angle="0"/>
                        </TransformGroup>
                    </map:MapView.RenderTransform>
                </map:MapView>
                <!-- compass: fixed disc, needle + N rotate to point at true north -->
                <Grid Width="36" Height="36" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6">
                    <Ellipse Fill="#B0000000" Stroke="{DynamicResource BorderBrush}" StrokeThickness="1"/>
                    <Canvas Width="36" Height="36" RenderTransformOrigin="0.5,0.5">
                        <Canvas.RenderTransform><RotateTransform x:Name="NeedleRotate" Angle="0"/></Canvas.RenderTransform>
                        <Polygon Points="18,4 22,20 18,16 14,20" Fill="#E53935" Stroke="White" StrokeThickness="0.5"/>
                        <TextBlock Canvas.Left="14" Canvas.Top="-3" Width="8" TextAlignment="Center" Text="N"
                                   FontSize="9" FontWeight="Bold" Foreground="White"/>
                    </Canvas>
                </Grid>
            </Grid>
        </DockPanel>
    </Border>
</Window>
